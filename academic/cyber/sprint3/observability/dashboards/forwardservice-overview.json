    {
      "id": 19,
      "type": "stat",
      "title": "AUC monitorada (REQ-03 >= 0,82)",
      "description": "AUC recalculada mensalmente com rótulos maduros; < 0,78 dispara retreino (Monitoring View TOGAF).",
