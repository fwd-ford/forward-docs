    {
      "id": 17,
      "type": "logs",
      "title": "Eventos de segurança (logs JSON no Loki)",
      "description": "Logs estruturados (LogstashEncoder) filtrados pelo campo event; correlação por request_id.",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 22
      },
      "datasource": {
        "type": "loki",
        "uid": "${ds_loki}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{app=\"forward-api\"} | json | event=~\"auth\\\\..*|authz\\\\..*|ratelimit\\\\..*|admin\\\\..*\"",
          "legendFormat": "",
          "datasource": {
            "type": "loki",
            "uid": "${ds_loki}"
          }
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true,
        "prettifyLogMessage": false
      }
    },
