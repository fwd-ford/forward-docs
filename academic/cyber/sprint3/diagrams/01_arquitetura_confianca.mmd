flowchart LR
  subgraph NET["Internet: zona não confiável"]
    MOB["App mobile Expo<br/>JWT no SecureStore"]
    WEB["Web SvelteKit"]
    N8N["N8N server-to-server<br/>X-API-Key + HMAC"]
    CAR["Veículo conectado TCU<br/>(proposto)"]
  end
  subgraph EDGE["Render edge"]
    TLS["TLS gerenciado<br/>HTTP redirecionado para HTTPS"]
  end
  subgraph API["forward-api-java no Render: container non-root"]
    FIL["RequestId, SecurityHeaders,<br/>RateLimit antes da autenticação"]
    SEC["Spring Security<br/>CORS + JWT próprio HS256"]
    CTL["Controllers REST/SOAP<br/>Validations, SecureXml, RFC 7807"]
    RBAC["RBAC ATENDENTE, GESTOR, ADMIN<br/>escopo por concessionária"]
  end
  subgraph IOT["Ingestão IoT (proposto)"]
    BRK["Broker MQTT<br/>mTLS :8883 + ACL"]
    ING["Serviço de ingestão"]
  end
  subgraph DATA["Supabase sa-east-1: produção"]
    POOL["Session pooler<br/>sslmode=require"]
    PG[("Postgres<br/>app_users, audit_log")]
    CRON["pg_cron<br/>reaper LGPD"]
  end
  subgraph MLZ["forward-ml"]
    SCORE["Scoring churn XGBoost<br/>sem PII direta"]
  end
  subgraph OBS["Observabilidade"]
    LOGS["Logs JSON<br/>request_id"]
    MET["Prometheus + Grafana<br/>alertas SLO"]
  end
  MOB --> TLS
  WEB --> TLS
  N8N --> TLS
  TLS --> FIL --> SEC --> CTL --> RBAC --> POOL --> PG
  CAR -. "MQTT sobre TLS, cert X.509 por veículo" .-> BRK --> ING --> PG
  SCORE -- "features pseudonimizadas" --> PG
  CRON --> PG
  CTL -. "stdout / Log Stream" .-> LOGS
  CTL -. "métricas" .-> MET
